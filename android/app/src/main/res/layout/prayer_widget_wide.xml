<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- The entire widget is drawn as a bitmap — no background drawable needed -->
    <ImageView
        android:id="@+id/w_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <!-- Hidden stubs — keep R.id references alive so Kotlin won't crash -->
    <TextView android:id="@+id/w_clock"         android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_next_name"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_clock_ampm"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_next_label"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_next_time"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_fajr_name"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_fajr_adhan"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_fajr_jamaat"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_sunrise_adhan"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_dhuhr_name"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_dhuhr_adhan"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_dhuhr_jamaat"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_asr_adhan"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_asr_jamaat"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_maghrib_adhan"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_isha_adhan"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />
    <TextView android:id="@+id/w_isha_jamaat"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="1sp" android:visibility="gone" />

</LinearLayout>